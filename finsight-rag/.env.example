# Copy to .env and fill in what you need:  cp .env.example .env
# .env is gitignored. Never commit real keys.
# Real environment variables override values in .env.

# --- Which profile YAML to load (default: configs/local.yaml) ---
# FINSIGHT_CONFIG=configs/cloud.yaml

# --- LLM provider (overrides the YAML profile) ---
# LLM_PROVIDER=ollama            # ollama | anthropic
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# ANTHROPIC_MODEL=claude-opus-5-5
# JUDGE_PROVIDER=ollama          # ollama | anthropic

# --- Secrets: only needed for the optional cloud providers ---
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Vector store: leave empty for embedded mode (indexes/qdrant) ---
QDRANT_URL=

LOG_LEVEL=INFO

# --- Any setting can be overridden with FINSIGHT__SECTION__KEY ---
# FINSIGHT__CHUNKING__CHUNK_TOKENS=256
# FINSIGHT__RETRIEVAL__FILTER_FIELDS=["company","doc_period"]
