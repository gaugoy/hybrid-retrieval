# Copy to .env and fill in what you need:  cp .env.example .env
# .env is gitignored. Never commit real keys.
# Real environment variables override values in .env.

# --- Which profile YAML to load (default: configs/local.yaml) ---
# FINSIGHT_CONFIG=configs/cloud.yaml

# --- LLM: a preset from configs/llms.yaml (list + what "auto" picks: uv run finsight llms) ---
# LLM=auto                       # auto | ollama-qwen7b | hf-qwen1.5b | claude-opus | claude-haiku |
#                                # gemini-flash | mistral-small | groq-llama | openai-mini (paid)
# JUDGE=auto                     # the answer grader (P8); prefer a different model than LLM
# OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding model: a preset from configs/embedders.yaml (list: uv run finsight embedders) ---
# EMBEDDER=bge-small             # local default. Online free tiers: gemini-001, gemini-2,
#                                # mistral-embed, cohere-v4, jina-v3, voyage-3.5-lite
# FINSIGHT__EMBEDDING__ALLOW_PAID=false   # OpenAI presets are refused unless this is true
# FINSIGHT__EMBEDDING__MAX_TOKENS_PER_RUN=2000000   # hard stop for online embedders

# --- Secrets: only needed for the optional online providers. All have free tiers except OpenAI ---
ANTHROPIC_API_KEY=
COHERE_API_KEY=cohere_PCxfEp4sOVy4dCung0Xwz4dNi3zTaitDpc8wKEGX3q8GzQ                  # trial key, 1,000 calls/month: https://dashboard.cohere.com/api-keys
GEMINI_API_KEY=                 # free (Google AI Studio): https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works)
MISTRAL_API_KEY=                 # free "Experiment" plan: https://console.mistral.ai/
JINA_API_KEY=                    # free token grant: https://jina.ai/api-dashboard/
VOYAGE_API_KEY=                  # 200M free tokens, low limits without a card: https://dashboard.voyageai.com/
OPENAI_API_KEY=                  # PAID only (no free tier); also needs ALLOW_PAID=true
GROQ_API_KEY=                    # free tier, very fast LLMs: https://console.groq.com/keys

# --- Vector store: leave empty for embedded mode (indexes/qdrant) ---
QDRANT_URL=

LOG_LEVEL=INFO

# --- Any setting can be overridden with FINSIGHT__SECTION__KEY ---
# FINSIGHT__CHUNKING__CHUNK_TOKENS=256
# FINSIGHT__RETRIEVAL__FILTER_FIELDS=["company","doc_period"]
